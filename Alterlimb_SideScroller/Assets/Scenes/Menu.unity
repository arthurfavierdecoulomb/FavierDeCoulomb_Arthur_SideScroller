  m_Script: {fileID: 11500000, guid: bbc3079fb1d11114b876a32dbb487640, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroCinematic
  screens:
  - text: Je ne me souviens pas du bruit.
    displayDuration: 2
  - text: "Juste de la lumi\xE8re."
    displayDuration: 2
  - text: "Et du silence, apr\xE8s."
    displayDuration: 2
  - text: "On dit que la m\xE9moire prot\xE8ge."
    displayDuration: 2
  - text: Qu'elle efface ce qui fait trop mal.
    displayDuration: 1.5
  - text: "Il y a eu une explosion. J'\xE9tais au centre."
    displayDuration: 2
  - text: "\xC0 mon r\xE9veil, sept jours avaient disparu."
    displayDuration: 1.5
  - text: Il y avait des points de suture. Et de l'acier.
    displayDuration: 1.5
  - text: Un bras. Deux jambes. Ce ne sont pas les miens.
    displayDuration: 1.5
  - text: "Quelqu'un m'a r\xE9par\xE9. Il a sauv\xE9 une partie de moi"
    displayDuration: 1.5
  - text: "Reste \xE0 savoir laquelle."
    displayDuration: 2
  cinematicText: {fileID: 1526076818}
  cinematicFade: {fileID: 1410773891}
  menuFade: {fileID: 1977858584}
  typewriterDelay: 0.035
  blackHoldBetweenScreens: 0.4
  blackHoldBeforeMenu: 0.5
  skipEnabled: 1
  skipHintFade: {fileID: 1410773891}
  skipHintDelay: 2
  skipOnAnyKey: 0
  skipKey: 13
  cinematicMusicSource: {fileID: 1489269354}
  menuMusicSource: {fileID: 667259366}
  musicFadeOutDuration: 1.5
  playOnStart: 1
